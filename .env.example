# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -base64 32   (use a different value for each)

# ── Database (PostgreSQL — use a NEW database for this country site) ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
# REQUIRED when running `next start` on your own server (VPS / cPanel / Docker); not needed on Vercel.
# Without it every login fails with "UntrustedHost" (HTTP 500).
AUTH_TRUST_HOST="true"
AUTH_SECRET=""

# ── Admin (used by seed; seed refuses to run if unset) ────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Storage: local | r2 | s3 ──────────────────────────────
CDN_PROVIDER="local"
UPLOAD_DIR="public/uploads"
# R2_PUBLIC_URL=""
# AWS_BUCKET_NAME=""
# AWS_REGION=""

# ── App / branding ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="MBBS in Belarus"
# Google Tag Manager container id (e.g. GTM-XXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GTM_ID=""

# ── Email (Gmail SMTP app password) ───────────────────────
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# EMAIL_FROM_NAME=""

# ── Optional ──────────────────────────────────────────────
# LEAD_WEBHOOK_URL=""        # fallback; normally set in Admin → Leads → Webhook
# LEAD_WEBHOOK_SECRET=""
# SEED_SAMPLE_LEADS="false"
